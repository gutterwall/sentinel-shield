<?xml version="1.0"?>
<phpunit
    bootstrap="tests/bootstrap.php"
    colors="true"
    defaultTestSuite="unit"
    beStrictAboutTestsThatDoNotTestAnything="true"
    convertDeprecationsToExceptions="true"
>
    <testsuites>
        <!-- Pure logic, no WordPress required: vendor/bin/phpunit -->
        <testsuite name="unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <!-- Needs the WordPress test suite: WP_TESTS_DIR=/tmp/wordpress-tests-lib composer test:integration -->
        <testsuite name="integration">
            <directory suffix="Test.php">./tests/Integration</directory>
        </testsuite>
    </testsuites>
    <!-- bin/coverage.sh: the early firewall is measured in the HTTP tests' own
         servers too; uninstall.php runs only in bin/lifecycle-test.sh. -->
    <coverage>
        <include>
            <directory suffix=".php">./src</directory>
            <file>./sentinel-shield.php</file>
            <file>./early-gate.php</file>
        </include>
    </coverage>
</phpunit>
