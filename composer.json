{
    "name": "sentinel-shield/sentinel-shield",
    "description": "Self-hosted WordPress security plugin: firewall, brute-force protection, IP blocklists and hardening.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpunit/phpcov": "^8.2",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "phpstan/extension-installer": "^1.4",
        "php-stubs/wp-cli-stubs": "^2.11"
    },
    "autoload": {
        "psr-4": {
            "SentinelShield\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SentinelShield\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "test": "phpunit",
        "test:integration": "phpunit --testsuite integration",
        "docs": "php bin/settings-docs.php --write",
        "build": "bin/build.sh"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true
    }
}
